PREFIX clo: <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?user ?userLabel ?preferredColor ?item ?itemLabel ?class
WHERE {
  ?user rdf:type clo:User ;
        rdfs:label ?userLabel ;
        clo:prefersColor ?preferredColor .
  ?item clo:hasColor ?preferredColor ;
        rdfs:label ?itemLabel ;
        rdf:type ?class .
  FILTER(?class != owl:NamedIndividual)
}
ORDER BY ?userLabel ?preferredColor ?itemLabel
LIMIT 50

