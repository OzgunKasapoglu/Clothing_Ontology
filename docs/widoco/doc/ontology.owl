<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology#"
     xml:base="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:Clothing-o="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v2"/>
        <terms:creator xml:lang="en">g911</terms:creator>
        <terms:description xml:lang="en">An OWL 2 ontology that models clothing items, their attributes (color, material, size, formality), and outfit-level compatibility relations. The ontology is designed to support a rule-based outfit combination engine that recommends harmonious outfits based on color theory, material compatibility, occasion, season, and personalized user preferences.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</terms:modified>
        <terms:title xml:lang="en">Clothing Ontology for Outfit Combination Engine</terms:title>
        <vann:preferredNamespacePrefix>clo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Version 2 extends v1 with: an Outfit module (Outfit class and part-of properties), a richer Attribute module (ColorScheme, ColorUndertone, FormalityLevel), a User module for personalization, schema.org alignment, and one machine-readable SWRL rule plus documented rule designs for color-harmony, formality-consistency, season-coherence and material-conflict heuristics.</rdfs:comment>
        <owl:priorVersion rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v1"/>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>
    


