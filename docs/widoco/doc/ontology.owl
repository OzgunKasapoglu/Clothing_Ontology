    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/clashesWith -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/clashesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/pairsWellWith"/>
        <rdfs:comment xml:lang="en">Symmetric incompatibility relation between two clothing items (e.g., conflicting formality or clashing colors).</rdfs:comment>
        <rdfs:label xml:lang="en">clashes with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/colorHarmonizesWith -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/colorHarmonizesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:comment xml:lang="en">Symmetric relation between two colors that form an aesthetically pleasing pair according to color-theory heuristics (complementary, analogous, neutral pairing).</rdfs:comment>
        <rdfs:label xml:lang="en">color harmonizes with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAccessory -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAccessory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory"/>
        <rdfs:comment xml:lang="en">Optional accessory(ies) included in an Outfit (belt, hat, watch, scarf).</rdfs:comment>
        <rdfs:label xml:lang="en">has accessory</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBodyType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBodyType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/BodyType"/>
        <rdfs:comment xml:lang="en">Body type of the user, used by future fit-aware recommendations.</rdfs:comment>
        <rdfs:label xml:lang="en">has body type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom"/>
        <rdfs:comment xml:lang="en">Relates an Outfit to the Bottom garment it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">has bottom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColor -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColor">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/color"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:comment xml:lang="en">Associates a clothing item with one or more colors that appear on it.</rdfs:comment>
        <rdfs:label xml:lang="en">has color</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColorScheme -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColorScheme">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorScheme"/>
        <rdfs:comment xml:lang="en">The overall color scheme of an outfit (e.g., Monochromatic, Complementary, Analogous).</rdfs:comment>
        <rdfs:label xml:lang="en">has color scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
        <rdfs:comment xml:lang="en">Relates an Outfit to its footwear component.</rdfs:comment>
        <rdfs:label xml:lang="en">has footwear</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFormality -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFormality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalityLevel"/>
        <rdfs:comment xml:lang="en">The dress-code formality level of a clothing item (Casual, SmartCasual, BusinessCasual, FormalDress).</rdfs:comment>
        <rdfs:label xml:lang="en">has formality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasMaterial -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasMaterial">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/material"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Material"/>
        <rdfs:comment xml:lang="en">Associates a clothing item with its primary fabric or material composition.</rdfs:comment>
        <rdfs:label xml:lang="en">has material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasOuterwear -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasOuterwear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear"/>
        <rdfs:comment xml:lang="en">Optional outerwear component of an Outfit (jacket, coat, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">has outerwear</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasSize -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasSize">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/size"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Size"/>
        <rdfs:comment xml:lang="en">Associates a clothing item with a single size value drawn from a standard size scale.</rdfs:comment>
        <rdfs:label xml:lang="en">has size</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
        <rdfs:comment xml:lang="en">Relates an Outfit to the Top garment it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">has top</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasUndertone -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasUndertone">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorUndertone"/>
        <rdfs:comment xml:lang="en">The undertone (warm, cool, or neutral) of a color. Used by the color harmony rules of the outfit engine.</rdfs:comment>
        <rdfs:label xml:lang="en">has undertone</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForOccasion -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForOccasion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion"/>
        <rdfs:comment xml:lang="en">States that a clothing item or outfit is suitable for a particular social occasion.</rdfs:comment>
        <rdfs:label xml:lang="en">is appropriate for occasion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForSeason -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForSeason">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Season"/>
        <rdfs:comment xml:lang="en">States that a clothing item or outfit is suitable for a particular season.</rdfs:comment>
        <rdfs:label xml:lang="en">is appropriate for season</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isComplementaryTo -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isComplementaryTo">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/colorHarmonizesWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:comment xml:lang="en">Specialization of colorHarmonizesWith for the complementary case (opposite hues on the color wheel).</rdfs:comment>
        <rdfs:label xml:lang="en">is complementary to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isSuitableFor -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isSuitableFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Gender"/>
        <rdfs:comment xml:lang="en">Indicates that the clothing item is designed or commonly worn for a given gender presentation. Use :Unisex when no preference applies.</rdfs:comment>
        <rdfs:label xml:lang="en">is suitable for gender</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ownsItem -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ownsItem">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:comment xml:lang="en">Associates a user with the clothing items currently in their wardrobe.</rdfs:comment>
        <rdfs:label xml:lang="en">owns item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/pairsWellWith -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/pairsWellWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:comment xml:lang="en">Symmetric compatibility relation between two clothing items, inferred by the SWRL outfit-compatibility rules.</rdfs:comment>
        <rdfs:label xml:lang="en">pairs well with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersColor -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersColor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color"/>
        <rdfs:comment xml:lang="en">Records a color the user reports as a preference. Used by the personalization layer when ranking recommended outfits.</rdfs:comment>
        <rdfs:label xml:lang="en">prefers color</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersStyle -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersStyle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/StyleCategory"/>
        <rdfs:comment xml:lang="en">Records a style category the user reports as a preference (Minimalist, Classic, Streetwear, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">prefers style</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/recommendedOutfit -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/recommendedOutfit">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:comment xml:lang="en">Outfit that the engine has produced as a recommendation for the user.</rdfs:comment>
        <rdfs:label xml:lang="en">recommended outfit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/color -->


    <owl:ObjectProperty rdf:about="https://schema.org/color"/>
    


    <!-- https://schema.org/material -->


    <owl:ObjectProperty rdf:about="https://schema.org/material"/>
    


    <!-- https://schema.org/size -->


    <owl:ObjectProperty rdf:about="https://schema.org/size"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/brandName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/brandName">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/brand"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Free-text brand or manufacturer name of the clothing item.</rdfs:comment>
        <rdfs:label xml:lang="en">brand name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAge -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Age of the user in completed years.</rdfs:comment>
        <rdfs:label xml:lang="en">has age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasPrice -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasPrice">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/price"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Retail price of the clothing item, expressed as a decimal value. Currency is not encoded at the property level.</rdfs:comment>
        <rdfs:label xml:lang="en">has price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isMachineWashable -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isMachineWashable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean flag stating whether the item can be machine-washed.</rdfs:comment>
        <rdfs:label xml:lang="en">is machine washable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/userName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/userName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Display name of the user.</rdfs:comment>
        <rdfs:label xml:lang="en">user name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/brand -->


    <owl:DatatypeProperty rdf:about="https://schema.org/brand"/>
    


    <!-- https://schema.org/price -->


    <owl:DatatypeProperty rdf:about="https://schema.org/price"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:comment xml:lang="en">Non-garment wearable that complements an outfit (Belt, Hat, Scarf, Watch).</rdfs:comment>
        <rdfs:label xml:lang="en">Accessory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute">
        <rdfs:comment xml:lang="en">Abstract grouping class for properties used to describe a ClothingItem (Color, Material, Size, Season, Occasion, Gender, FormalityLevel, ColorScheme, ColorUndertone).</rdfs:comment>
        <rdfs:label xml:lang="en">Attribute</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Belt -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Belt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory"/>
        <rdfs:comment xml:lang="en">Waist Accessory.</rdfs:comment>
        <rdfs:label xml:lang="en">Belt</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Blouse -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Blouse">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
        <rdfs:comment xml:lang="en">Loose-fitting Top, typically SmartCasual to BusinessCasual.</rdfs:comment>
        <rdfs:label xml:lang="en">Blouse</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/BodyType -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/BodyType">
        <rdfs:comment xml:lang="en">Body-shape classification used by future fit-aware recommendations.</rdfs:comment>
        <rdfs:label xml:lang="en">Body Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Boots -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Boots">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
        <rdfs:comment xml:lang="en">Ankle-or-higher Footwear, typically Autumn/Winter.</rdfs:comment>
        <rdfs:label xml:lang="en">Boots</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:comment xml:lang="en">Lower-body garment (Jean, Trouser, Short, Skirt).</rdfs:comment>
        <rdfs:label xml:lang="en">Bottom</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/CasualOutfit -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/CasualOutfit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:comment xml:lang="en">Outfit whose items each have Casual formality. Target class for documented SWRL rule R3; only R1 is machine-encoded in this version.</rdfs:comment>
        <rdfs:label xml:lang="en">Casual Outfit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem">
        <rdfs:subClassOf rdf:resource="https://schema.org/Product"/>
        <rdfs:comment xml:lang="en">Top-level class for any wearable article. Direct subclasses partition garments by body region (Top, Bottom, Outerwear, Footwear, Accessory).</rdfs:comment>
        <rdfs:label xml:lang="en">Clothing Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Coat -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Coat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear"/>
        <rdfs:comment xml:lang="en">Long Outerwear designed for cold weather.</rdfs:comment>
        <rdfs:label xml:lang="en">Coat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">A named color value (Red, Blue, Black, ...).</rdfs:comment>
        <rdfs:label xml:lang="en">Color</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorScheme -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorScheme">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">A color-theory scheme applied to an Outfit (Monochromatic, Analogous, Complementary, Triadic, Neutral).</rdfs:comment>
        <rdfs:label xml:lang="en">Color Scheme</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorUndertone -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorUndertone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">Undertone classification of a Color: Warm, Cool, or NeutralUndertone.</rdfs:comment>
        <rdfs:label xml:lang="en">Color Undertone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:comment xml:lang="en">Foot covering (Boots, Sandals, FormalShoes, SportsShoes).</rdfs:comment>
        <rdfs:label xml:lang="en">Footwear</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalOutfit -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalOutfit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:comment xml:lang="en">Outfit whose items each have FormalDress formality. Target class for documented SWRL rule R2; only R1 is machine-encoded in this version.</rdfs:comment>
        <rdfs:label xml:lang="en">Formal Outfit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalShoes -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalShoes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
        <rdfs:comment xml:lang="en">FormalDress-level Footwear (oxford, derby, loafer).</rdfs:comment>
        <rdfs:label xml:lang="en">Formal Shoes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalityLevel -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalityLevel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">Dress-code level: Casual, SmartCasual, BusinessCasual, FormalDress.</rdfs:comment>
        <rdfs:label xml:lang="en">Formality Level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Gender -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Gender">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">Gender presentation an item is designed for (Male, Female, Unisex).</rdfs:comment>
        <rdfs:label xml:lang="en">Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/HarmoniousOutfit -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/HarmoniousOutfit">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit"/>
        <rdfs:comment xml:lang="en">An Outfit whose constituent items satisfy the color-harmony and formality-consistency rules. Membership is inferred by the SWRL ruleset.</rdfs:comment>
        <rdfs:label xml:lang="en">Harmonious Outfit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hat -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory"/>
        <rdfs:comment xml:lang="en">Head Accessory.</rdfs:comment>
        <rdfs:label xml:lang="en">Hat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hoodie -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hoodie">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
        <rdfs:comment xml:lang="en">Hooded sweatshirt; Casual formality.</rdfs:comment>
        <rdfs:label xml:lang="en">Hoodie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jacket -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jacket">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear"/>
        <rdfs:comment xml:lang="en">Hip-length Outerwear.</rdfs:comment>
        <rdfs:label xml:lang="en">Jacket</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jean -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jean">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom"/>
        <rdfs:comment xml:lang="en">Denim Bottom; Casual to SmartCasual.</rdfs:comment>
        <rdfs:label xml:lang="en">Jean</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Material -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Material">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">A textile material or fabric (Cotton, Wool, Silk, Polyester, ...).</rdfs:comment>
        <rdfs:label xml:lang="en">Material</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">A social occasion or context (Casual, Work, Formal, Sport).</rdfs:comment>
        <rdfs:label xml:lang="en">Occasion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
        <rdfs:comment xml:lang="en">Outer layer worn over a Top (Jacket, Coat).</rdfs:comment>
        <rdfs:label xml:lang="en">Outerwear</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A complete styled combination of clothing items containing at least a Top, a Bottom and Footwear, optionally extended with Outerwear and Accessories. Outfits are the primary output of the recommendation engine.</rdfs:comment>
        <rdfs:label xml:lang="en">Outfit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Sandals -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Sandals">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
        <rdfs:comment xml:lang="en">Open Footwear, Summer-leaning.</rdfs:comment>
        <rdfs:label xml:lang="en">Sandals</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Scarf -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Scarf">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory"/>
        <rdfs:comment xml:lang="en">Neck Accessory.</rdfs:comment>
        <rdfs:label xml:lang="en">Scarf</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Season -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Season">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">A season of the year (Spring, Summer, Autumn, Winter).</rdfs:comment>
        <rdfs:label xml:lang="en">Season</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Short -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Short">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom"/>
        <rdfs:comment xml:lang="en">Knee-length or shorter Bottom; Casual, Summer-leaning.</rdfs:comment>
        <rdfs:label xml:lang="en">Short</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Size -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Size">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute"/>
        <rdfs:comment xml:lang="en">A standard garment size (XS, S, M, L, XL, XXL).</rdfs:comment>
        <rdfs:label xml:lang="en">Size</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Skirt -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Skirt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom"/>
        <rdfs:comment xml:lang="en">Skirted Bottom.</rdfs:comment>
        <rdfs:label xml:lang="en">Skirt</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/SportsShoes -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/SportsShoes">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
        <rdfs:comment xml:lang="en">Athletic Footwear (sneaker, running shoe).</rdfs:comment>
        <rdfs:label xml:lang="en">Sports Shoes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/StyleCategory -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/StyleCategory">
        <rdfs:comment xml:lang="en">Named aesthetic style preference (Minimalist, Classic, Streetwear, BohoChic, Sporty, ...).</rdfs:comment>
        <rdfs:label xml:lang="en">Style Category</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Sweater -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Sweater">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
        <rdfs:comment xml:lang="en">Knitted Top suitable for cold seasons.</rdfs:comment>
        <rdfs:label xml:lang="en">Sweater</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/T-Shirt -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/T-Shirt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
        <rdfs:comment xml:lang="en">Short-sleeved knit Top, typically Casual.</rdfs:comment>
        <rdfs:label xml:lang="en">T-Shirt</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top -->


    <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem"/>
