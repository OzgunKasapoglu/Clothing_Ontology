@prefix : <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology#> .

<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology> rdf:type owl:Ontology ;
                                                                       owl:versionIRI <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v2> ;
                                                                       <http://purl.org/dc/terms/creator> "g911"@en ;
                                                                       <http://purl.org/dc/terms/description> "An OWL 2 ontology that models clothing items, their attributes (color, material, size, formality), and outfit-level compatibility relations. The ontology is designed to support a rule-based outfit combination engine that recommends harmonious outfits based on color theory, material compatibility, occasion, season, and personalized user preferences."@en ;
                                                                       <http://purl.org/dc/terms/issued> "2026-04-01"^^xsd:date ;
                                                                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                                       <http://purl.org/dc/terms/modified> "2026-06-16"^^xsd:date ;
                                                                       <http://purl.org/dc/terms/title> "Clothing Ontology for Outfit Combination Engine"@en ;
                                                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "clo" ;
                                                                       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/" ;
                                                                       rdfs:comment "Version 2 extends v1 with: an Outfit module (Outfit class and part-of properties), a richer Attribute module (ColorScheme, ColorUndertone, FormalityLevel), a User module for personalization, schema.org alignment, and one machine-readable SWRL rule plus documented rule designs for color-harmony, formality-consistency, season-coherence and material-conflict heuristics."@en ;
                                                                       owl:priorVersion <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v1> ;
                                                                       owl:versionInfo "2.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument1
<http://www.w3.org/2003/11/swrl#argument1> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#argument2
<http://www.w3.org/2003/11/swrl#argument2> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#body
<http://www.w3.org/2003/11/swrl#body> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#classPredicate
<http://www.w3.org/2003/11/swrl#classPredicate> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#head
<http://www.w3.org/2003/11/swrl#head> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#propertyPredicate
<http://www.w3.org/2003/11/swrl#propertyPredicate> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/clashesWith
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/clashesWith> rdf:type owl:ObjectProperty ,
                                                                                    owl:SymmetricProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                           rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                           owl:propertyDisjointWith <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/pairsWellWith> ;
                                                                           rdfs:comment "Symmetric incompatibility relation between two clothing items (e.g., conflicting formality or clashing colors)."@en ;
                                                                           rdfs:label "clashes with"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/colorHarmonizesWith
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/colorHarmonizesWith> rdf:type owl:ObjectProperty ,
                                                                                            owl:SymmetricProperty ;
                                                                                   rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                                   rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                                   rdfs:comment "Symmetric relation between two colors that form an aesthetically pleasing pair according to color-theory heuristics (complementary, analogous, neutral pairing)."@en ;
                                                                                   rdfs:label "color harmonizes with"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAccessory
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAccessory> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                            rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory> ;
                                                                            rdfs:comment "Optional accessory(ies) included in an Outfit (belt, hat, watch, scarf)."@en ;
                                                                            rdfs:label "has accessory"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBodyType
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBodyType> rdf:type owl:ObjectProperty ,
                                                                                    owl:FunctionalProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                           rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/BodyType> ;
                                                                           rdfs:comment "Body type of the user, used by future fit-aware recommendations."@en ;
                                                                           rdfs:label "has body type"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom> rdf:type owl:ObjectProperty ;
                                                                         rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                         rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom> ;
                                                                         rdfs:comment "Relates an Outfit to the Bottom garment it contains."@en ;
                                                                         rdfs:label "has bottom"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColor
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColor> rdf:type owl:ObjectProperty ;
                                                                        rdfs:subPropertyOf <https://schema.org/color> ;
                                                                        rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                        rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                        rdfs:comment "Associates a clothing item with one or more colors that appear on it."@en ;
                                                                        rdfs:label "has color"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColorScheme
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColorScheme> rdf:type owl:ObjectProperty ;
                                                                              rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                              rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorScheme> ;
                                                                              rdfs:comment "The overall color scheme of an outfit (e.g., Monochromatic, Complementary, Analogous)."@en ;
                                                                              rdfs:label "has color scheme"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear> rdf:type owl:ObjectProperty ;
                                                                           rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                           rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear> ;
                                                                           rdfs:comment "Relates an Outfit to its footwear component."@en ;
                                                                           rdfs:label "has footwear"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFormality
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFormality> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                            rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalityLevel> ;
                                                                            rdfs:comment "The dress-code formality level of a clothing item (Casual, SmartCasual, BusinessCasual, FormalDress)."@en ;
                                                                            rdfs:label "has formality"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasMaterial
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasMaterial> rdf:type owl:ObjectProperty ;
                                                                           rdfs:subPropertyOf <https://schema.org/material> ;
                                                                           rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                           rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Material> ;
                                                                           rdfs:comment "Associates a clothing item with its primary fabric or material composition."@en ;
                                                                           rdfs:label "has material"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasOuterwear
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasOuterwear> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                            rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear> ;
                                                                            rdfs:comment "Optional outerwear component of an Outfit (jacket, coat, etc.)."@en ;
                                                                            rdfs:label "has outerwear"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasSize
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasSize> rdf:type owl:ObjectProperty ;
                                                                       rdfs:subPropertyOf <https://schema.org/size> ;
                                                                       rdf:type owl:FunctionalProperty ;
                                                                       rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                       rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Size> ;
                                                                       rdfs:comment "Associates a clothing item with a single size value drawn from a standard size scale."@en ;
                                                                       rdfs:label "has size"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop> rdf:type owl:ObjectProperty ;
                                                                      rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                      rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top> ;
                                                                      rdfs:comment "Relates an Outfit to the Top garment it contains."@en ;
                                                                      rdfs:label "has top"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasUndertone
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasUndertone> rdf:type owl:ObjectProperty ,
                                                                                     owl:FunctionalProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                            rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorUndertone> ;
                                                                            rdfs:comment "The undertone (warm, cool, or neutral) of a color. Used by the color harmony rules of the outfit engine."@en ;
                                                                            rdfs:label "has undertone"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForOccasion
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForOccasion> rdf:type owl:ObjectProperty ;
                                                                                        rdfs:domain [ rdf:type owl:Class ;
                                                                                                      owl:unionOf ( <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem>
                                                                                                                    <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit>
                                                                                                                  )
                                                                                                    ] ;
                                                                                        rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion> ;
                                                                                        rdfs:comment "States that a clothing item or an outfit is suitable for a particular social occasion. The domain is the union of ClothingItem and Outfit because both individual garments and whole outfits carry an occasion."@en ;
                                                                                        rdfs:label "is appropriate for occasion"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForSeason
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForSeason> rdf:type owl:ObjectProperty ;
                                                                                      rdfs:domain [ rdf:type owl:Class ;
                                                                                                    owl:unionOf ( <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem>
                                                                                                                  <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit>
                                                                                                                )
                                                                                                  ] ;
                                                                                      rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Season> ;
                                                                                      rdfs:comment "States that a clothing item or an outfit is suitable for a particular season. The domain is the union of ClothingItem and Outfit because both individual garments and whole outfits carry a season."@en ;
                                                                                      rdfs:label "is appropriate for season"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isComplementaryTo
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isComplementaryTo> rdf:type owl:ObjectProperty ;
                                                                                 rdfs:subPropertyOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/colorHarmonizesWith> ;
                                                                                 rdf:type owl:SymmetricProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                                 rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                                 rdfs:comment "Specialization of colorHarmonizesWith for the complementary case (opposite hues on the color wheel)."@en ;
                                                                                 rdfs:label "is complementary to"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isSuitableFor
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isSuitableFor> rdf:type owl:ObjectProperty ;
                                                                             rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                             rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Gender> ;
                                                                             rdfs:comment "Indicates that the clothing item is designed or commonly worn for a given gender presentation. Use :Unisex when no preference applies."@en ;
                                                                             rdfs:label "is suitable for gender"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ownsItem
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ownsItem> rdf:type owl:ObjectProperty ;
                                                                        rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                        rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                        rdfs:comment "Associates a user with the clothing items currently in their wardrobe."@en ;
                                                                        rdfs:label "owns item"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/pairsWellWith
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/pairsWellWith> rdf:type owl:ObjectProperty ,
                                                                                      owl:SymmetricProperty ;
                                                                             rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                             rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                             rdfs:comment "Symmetric compatibility relation between two clothing items, inferred by the SWRL outfit-compatibility rules."@en ;
                                                                             rdfs:label "pairs well with"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersColor
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersColor> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                            rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> ;
                                                                            rdfs:comment "Records a color the user reports as a preference. Used by the personalization layer when ranking recommended outfits."@en ;
                                                                            rdfs:label "prefers color"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersStyle
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/prefersStyle> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                            rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/StyleCategory> ;
                                                                            rdfs:comment "Records a style category the user reports as a preference (Minimalist, Classic, Streetwear, etc.)."@en ;
                                                                            rdfs:label "prefers style"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/recommendedOutfit
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/recommendedOutfit> rdf:type owl:ObjectProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                                 rdfs:range <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                                 rdfs:comment "Outfit that the engine has produced as a recommendation for the user."@en ;
                                                                                 rdfs:label "recommended outfit"@en .


###  https://schema.org/color
<https://schema.org/color> rdf:type owl:ObjectProperty .


###  https://schema.org/material
<https://schema.org/material> rdf:type owl:ObjectProperty .


###  https://schema.org/size
<https://schema.org/size> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/brandName
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/brandName> rdf:type owl:DatatypeProperty ;
                                                                         rdfs:subPropertyOf <https://schema.org/brand> ;
                                                                         rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                         rdfs:range xsd:string ;
                                                                         rdfs:comment "Free-text brand or manufacturer name of the clothing item."@en ;
                                                                         rdfs:label "brand name"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAge
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasAge> rdf:type owl:DatatypeProperty ,
                                                                               owl:FunctionalProperty ;
                                                                      rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                      rdfs:range xsd:integer ;
                                                                      rdfs:comment "Age of the user in completed years."@en ;
                                                                      rdfs:label "has age"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasPrice
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasPrice> rdf:type owl:DatatypeProperty ;
                                                                        rdfs:subPropertyOf <https://schema.org/price> ;
                                                                        rdf:type owl:FunctionalProperty ;
                                                                        rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                        rdfs:range xsd:float ;
                                                                        rdfs:comment "Retail price of the clothing item, expressed as a decimal value. Currency is not encoded at the property level."@en ;
                                                                        rdfs:label "has price"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isMachineWashable
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isMachineWashable> rdf:type owl:DatatypeProperty ,
                                                                                          owl:FunctionalProperty ;
                                                                                 rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                                 rdfs:range xsd:boolean ;
                                                                                 rdfs:comment "Boolean flag stating whether the item can be machine-washed."@en ;
                                                                                 rdfs:label "is machine washable"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/userName
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/userName> rdf:type owl:DatatypeProperty ,
                                                                                 owl:FunctionalProperty ;
                                                                        rdfs:domain <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User> ;
                                                                        rdfs:range xsd:string ;
                                                                        rdfs:comment "Display name of the user."@en ;
                                                                        rdfs:label "user name"@en .


###  https://schema.org/brand
<https://schema.org/brand> rdf:type owl:DatatypeProperty .


###  https://schema.org/price
<https://schema.org/price> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                         rdfs:comment "Non-garment wearable that complements an outfit (Belt, Hat, Scarf, Watch)."@en ;
                                                                         rdfs:label "Accessory"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> rdf:type owl:Class ;
                                                                         rdfs:comment "Abstract grouping class for properties used to describe a ClothingItem (Color, Material, Size, Season, Occasion, Gender, FormalityLevel, ColorScheme, ColorUndertone)."@en ;
                                                                         rdfs:label "Attribute"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Belt
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Belt> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory> ;
                                                                    rdfs:comment "Waist Accessory."@en ;
                                                                    rdfs:label "Belt"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Blouse
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Blouse> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top> ;
                                                                      rdfs:comment "Loose-fitting Top, typically SmartCasual to BusinessCasual."@en ;
                                                                      rdfs:label "Blouse"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/BodyType
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/BodyType> rdf:type owl:Class ;
                                                                        rdfs:comment "Body-shape classification used by future fit-aware recommendations."@en ;
                                                                        rdfs:label "Body Type"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Boots
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Boots> rdf:type owl:Class ;
                                                                     rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear> ;
                                                                     rdfs:comment "Ankle-or-higher Footwear, typically Autumn/Winter."@en ;
                                                                     rdfs:label "Boots"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                      rdfs:comment "Lower-body garment (Jean, Trouser, Short, Skirt)."@en ;
                                                                      rdfs:label "Bottom"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/CasualOutfit
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/CasualOutfit> rdf:type owl:Class ;
                                                                            rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                            rdfs:comment "Outfit whose items each have Casual formality. Target class for documented SWRL rule R3; only R1 is machine-encoded in this version."@en ;
                                                                            rdfs:label "Casual Outfit"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> rdf:type owl:Class ;
                                                                            rdfs:subClassOf <https://schema.org/Product> ;
                                                                            rdfs:comment "Top-level class for any wearable article. Direct subclasses partition garments by body region (Top, Bottom, Outerwear, Footwear, Accessory)."@en ;
                                                                            rdfs:label "Clothing Item"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Coat
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Coat> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear> ;
                                                                    rdfs:comment "Long Outerwear designed for cold weather."@en ;
                                                                    rdfs:label "Coat"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Color> rdf:type owl:Class ;
                                                                     rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                     rdfs:comment "A named color value (Red, Blue, Black, ...)."@en ;
                                                                     rdfs:label "Color"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorScheme
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorScheme> rdf:type owl:Class ;
                                                                           rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                           rdfs:comment "A color-theory scheme applied to an Outfit (Monochromatic, Analogous, Complementary, Triadic, Neutral)."@en ;
                                                                           rdfs:label "Color Scheme"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorUndertone
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ColorUndertone> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                              rdfs:comment "Undertone classification of a Color: Warm, Cool, or NeutralUndertone."@en ;
                                                                              rdfs:label "Color Undertone"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                        rdfs:comment "Foot covering (Boots, Sandals, FormalShoes, SportsShoes)."@en ;
                                                                        rdfs:label "Footwear"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalOutfit
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalOutfit> rdf:type owl:Class ;
                                                                            rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                            rdfs:comment "Outfit whose items each have FormalDress formality. Target class for documented SWRL rule R2; only R1 is machine-encoded in this version."@en ;
                                                                            rdfs:label "Formal Outfit"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalShoes
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalShoes> rdf:type owl:Class ;
                                                                           rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear> ;
                                                                           rdfs:comment "FormalDress-level Footwear (oxford, derby, loafer)."@en ;
                                                                           rdfs:label "Formal Shoes"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalityLevel
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/FormalityLevel> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                              rdfs:comment "Dress-code level: Casual, SmartCasual, BusinessCasual, FormalDress."@en ;
                                                                              rdfs:label "Formality Level"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Gender
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Gender> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                      rdfs:comment "Gender presentation an item is designed for (Male, Female, Unisex)."@en ;
                                                                      rdfs:label "Gender"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/HarmoniousOutfit
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/HarmoniousOutfit> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> ;
                                                                                rdfs:comment "An Outfit whose constituent items satisfy the color-harmony and formality-consistency rules. Membership is inferred by the SWRL ruleset."@en ;
                                                                                rdfs:label "Harmonious Outfit"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hat
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hat> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Accessory> ;
                                                                   rdfs:comment "Head Accessory."@en ;
                                                                   rdfs:label "Hat"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hoodie
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hoodie> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top> ;
                                                                      rdfs:comment "Hooded sweatshirt; Casual formality."@en ;
                                                                      rdfs:label "Hoodie"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jacket
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jacket> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear> ;
                                                                      rdfs:comment "Hip-length Outerwear."@en ;
                                                                      rdfs:label "Jacket"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jean
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Jean> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom> ;
                                                                    rdfs:comment "Denim Bottom; Casual to SmartCasual."@en ;
                                                                    rdfs:label "Jean"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Material
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Material> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                        rdfs:comment "A textile material or fabric (Cotton, Wool, Silk, Polyester, ...)."@en ;
                                                                        rdfs:label "Material"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Attribute> ;
                                                                        rdfs:comment "A social occasion or context (Casual, Work, Formal, Sport)."@en ;
                                                                        rdfs:label "Occasion"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outerwear> rdf:type owl:Class ;
                                                                         rdfs:subClassOf <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/ClothingItem> ;
                                                                         rdfs:comment "Outer layer worn over a Top (Jacket, Coat)."@en ;
                                                                         rdfs:label "Outerwear"@en .


###  http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit
<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit> rdf:type owl:Class ;
                                                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom> ;
                                                                                        owl:someValuesFrom <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom>
                                                                                      ] ,
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear> ;
                                                                                        owl:someValuesFrom <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear>
                                                                                      ] ,
                                                                                      [ rdf:type owl:Restriction ;
                                                                                        owl:onProperty <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop> ;
                                                                                        owl:someValuesFrom <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top>
                                                                                      ] ;
                                                                      rdfs:comment "A complete styled combination of clothing items containing at least a Top, a Bottom and Footwear, optionally extended with Outerwear and Accessories. Outfits are the primary output of the recommendation engine."@en ;
                                                                      rdfs:label "Outfit"@en .


