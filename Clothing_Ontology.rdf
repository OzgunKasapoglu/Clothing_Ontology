  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForSeason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
