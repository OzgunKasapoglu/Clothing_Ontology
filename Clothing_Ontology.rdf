            <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
            <rdfs:label xml:lang="en">has top</rdfs:label>
            <rdfs:comment xml:lang="en">Relates an Outfit to the Top garment it contains.</rdfs:comment>
          </owl:ObjectProperty>
        </swrl:propertyPredicate>
        <swrl:argument1>
          <swrl:Variable rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b7">
            <rdfs:label>o</rdfs:label>
          </swrl:Variable>
        </swrl:argument1>
        <swrl:argument2>
          <swrl:Variable rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b8">
            <rdfs:label>t</rdfs:label>
          </swrl:Variable>
        </swrl:argument2>
