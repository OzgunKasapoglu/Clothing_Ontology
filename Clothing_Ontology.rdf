  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Monochromatic">
