    <isAppropriateForOccasion rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Casual"/>
    <isAppropriateForOccasion rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Sport"/>
