        <swrl:argument2>
          <swrl:Variable rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b11">
            <rdfs:label>b</rdfs:label>
          </swrl:Variable>
        </swrl:argument2>
      </swrl:IndividualPropertyAtom>
      <swrl:IndividualPropertyAtom rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b12">
        <swrl:propertyPredicate>
          <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasColor">
