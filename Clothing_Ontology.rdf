  <rdf:Description rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v2"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.0</owl:versionInfo>
    <owl:priorVersion rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v1"/>
    <dcterms:title xml:lang="en">Clothing Ontology for Outfit Combination Engine</dcterms:title>
    <dcterms:description xml:lang="en">An OWL 2 ontology that models clothing items, their attributes (color, material, size, formality), and outfit-level compatibility relations. The ontology is designed to support a rule-based outfit combination engine that recommends harmonious outfits based on color theory, material compatibility, occasion, season, and personalized user preferences.</dcterms:description>
    <dcterms:creator xml:lang="en">g911</dcterms:creator>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-01</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-16</dcterms:modified>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <vann:preferredNamespacePrefix>clo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Version 2 extends v1 with: an Outfit module (Outfit class and part-of properties), a richer Attribute module (ColorScheme, ColorUndertone, FormalityLevel), a User module for personalization, schema.org alignment, and one machine-readable SWRL rule plus documented rule designs for color-harmony, formality-consistency, season-coherence and material-conflict heuristics.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Grey_Hoodie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Hoodie"/>
    <rdfs:label xml:lang="en">Grey Hoodie</rdfs:label>
    <hasColor rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Grey"/>
    <hasMaterial rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Cotton"/>
    <hasSize rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/L"/>
    <hasFormality rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/CasualLevel"/>
    <isAppropriateForSeason rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Autumn"/>
    <isAppropriateForSeason rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Winter"/>
