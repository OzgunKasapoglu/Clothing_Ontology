      <swrl:IndividualPropertyAtom rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b9">
        <swrl:propertyPredicate>
          <owl:ObjectProperty rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom">
