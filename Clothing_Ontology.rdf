  <rdf:Description rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/isAppropriateForOccasion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="ne96a04a37911450e9b1f8190e24fb0b7b1"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion"/>
    <rdfs:label xml:lang="en">is appropriate for occasion</rdfs:label>
    <rdfs:comment xml:lang="en">States that a clothing item or an outfit is suitable for a particular social occasion. The domain is the union of ClothingItem and Outfit because both individual garments and whole outfits carry an occasion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/User">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">User</rdfs:label>
    <rdfs:comment xml:lang="en">End user of the outfit recommendation engine. Owns clothing items, has stated preferences, and receives recommended Outfits.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Occasion">
