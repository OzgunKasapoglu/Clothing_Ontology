    <rdfs:comment xml:lang="en">Dress-code level: Casual, SmartCasual, BusinessCasual, FormalDress.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Outfit">
    <rdfs:label xml:lang="en">Outfit</rdfs:label>
    <rdfs:comment xml:lang="en">A complete styled combination of clothing items containing at least a Top, a Bottom and Footwear, optionally extended with Outerwear and Accessories. Outfits are the primary output of the recommendation engine.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b1">
        <owl:onProperty rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasTop"/>
        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Top"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b2">
        <owl:onProperty rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasBottom"/>
        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Bottom"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na4d293c584dc403ca9fed1720f1bdf75b3">
        <owl:onProperty rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/hasFootwear"/>
        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Footwear"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
