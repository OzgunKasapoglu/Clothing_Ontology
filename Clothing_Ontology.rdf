    <rdfs:range rdf:resource="http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/Season"/>
    <rdfs:label xml:lang="en">is appropriate for season</rdfs:label>
    <rdfs:comment xml:lang="en">States that a clothing item or an outfit is suitable for a particular season. The domain is the union of ClothingItem and Outfit because both individual garments and whole outfits carry a season.</rdfs:comment>
  </rdf:Description>
