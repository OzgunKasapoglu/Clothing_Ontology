#################################################################
#    SWRL Rules — Outfit Combination Engine
#################################################################
#
# R1  Color-harmony pairing:
#     Outfit(?o) ^ hasTop(?o, ?t) ^ hasBottom(?o, ?b)
#     ^ hasColor(?t, ?ct) ^ hasColor(?b, ?cb)
#     ^ colorHarmonizesWith(?ct, ?cb)
#     -> pairsWellWith(?t, ?b)
#
# R2  Formal outfit classification:
#     Outfit(?o)
#     ^ hasTop(?o, ?t) ^ hasFormality(?t, FormalLevel)
#     ^ hasBottom(?o, ?b) ^ hasFormality(?b, FormalLevel)
#     ^ hasFootwear(?o, ?f) ^ hasFormality(?f, FormalLevel)
#     -> FormalOutfit(?o)
#
# R3  Casual outfit classification:
#     Outfit(?o)
#     ^ hasTop(?o, ?t) ^ hasFormality(?t, CasualLevel)
#     ^ hasBottom(?o, ?b) ^ hasFormality(?b, CasualLevel)
#     ^ hasFootwear(?o, ?f) ^ hasFormality(?f, CasualLevel)
#     -> CasualOutfit(?o)
#
# R4  Season coherence (Winter requires Outerwear):
#     Outfit(?o) ^ isAppropriateForSeason(?o, Winter)
#     ^ hasOuterwear(?o, ?w)
#     -> HarmoniousOutfit(?o)
#
# R5  Material conflict (Silk is not suitable for Sport):
#     ClothingItem(?x) ^ hasMaterial(?x, Silk) ^ isAppropriateForOccasion(?x, Sport)
#     -> clashesWith(?x, ?x)
#
# R6  Color clash (warm + cool without neutral) — diagnostic:
#     Outfit(?o) ^ hasTop(?o, ?t) ^ hasBottom(?o, ?b)
#     ^ hasColor(?t, ?ct) ^ hasColor(?b, ?cb)
#     ^ hasUndertone(?ct, Warm) ^ hasUndertone(?cb, Cool)
#     -> clashesWith(?t, ?b)
#
# The machine-readable SWRL encoding follows. Reasoners that do not support SWRL
# (e.g., pure OWL DL reasoners without rule extension) will simply ignore these
# axioms; Pellet, HermiT-with-SWRL, and Drools-backed engines will execute them.

:R1_ColorHarmonyPairing rdf:type swrl:Imp ;
    rdfs:label "R1 Color Harmony Pairing"@en ;
    rdfs:comment "If a Top and Bottom of the same Outfit have colors that harmonize, infer pairsWellWith between them."@en ;
    swrl:body (
        [ rdf:type swrl:ClassAtom ;
          swrl:classPredicate :Outfit ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "o" ] ]
        [ rdf:type swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasTop ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "o" ] ;
          swrl:argument2 [ rdf:type swrl:Variable ; rdfs:label "t" ] ]
        [ rdf:type swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasBottom ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "o" ] ;
          swrl:argument2 [ rdf:type swrl:Variable ; rdfs:label "b" ] ]
        [ rdf:type swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasColor ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "t" ] ;
          swrl:argument2 [ rdf:type swrl:Variable ; rdfs:label "ct" ] ]
        [ rdf:type swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasColor ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "b" ] ;
          swrl:argument2 [ rdf:type swrl:Variable ; rdfs:label "cb" ] ]
        [ rdf:type swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :colorHarmonizesWith ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "ct" ] ;
          swrl:argument2 [ rdf:type swrl:Variable ; rdfs:label "cb" ] ]
    ) ;
    swrl:head (
        [ rdf:type swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :pairsWellWith ;
          swrl:argument1 [ rdf:type swrl:Variable ; rdfs:label "t" ] ;
          swrl:argument2 [ rdf:type swrl:Variable ; rdfs:label "b" ] ]
    ) .

