@prefix : <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/> .


#################################################################
#    Ontology Metadata
#################################################################

<http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology>
    rdf:type owl:Ontology ;
    owl:versionIRI <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v2> ;
    owl:versionInfo "2.0"^^xsd:string ;
    owl:priorVersion <http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-Ontology/v1> ;
    dcterms:title "Clothing Ontology for Outfit Combination Engine"@en ;
    dcterms:description "An OWL 2 ontology that models clothing items, their attributes (color, material, size, formality), and outfit-level compatibility relations. The ontology is designed to support a rule-based outfit combination engine that recommends harmonious outfits based on color theory, material compatibility, occasion, season, and personalized user preferences."@en ;
    dcterms:creator "g911"@en ;
    dcterms:issued "2026-04-01"^^xsd:date ;
    dcterms:modified "2026-05-11"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "clo" ;
    vann:preferredNamespaceUri "http://www.semanticweb.org/g911/ontologies/2026/3/Clothing-o/" ;
    rdfs:comment "Version 2 extends v1 with: an Outfit module (Outfit class and part-of properties), a richer Attribute module (ColorScheme, ColorUndertone, FormalityLevel), a User module for personalization, schema.org alignment, and SWRL rules encoding color-harmony, formality-consistency, season-coherence and material-conflict heuristics."@en .


#################################################################
#    Annotation Properties
#################################################################

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:creator rdf:type owl:AnnotationProperty .
dcterms:issued rdf:type owl:AnnotationProperty .
dcterms:modified rdf:type owl:AnnotationProperty .
dcterms:license rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  hasColor
:hasColor rdf:type owl:ObjectProperty ;
          rdfs:domain :ClothingItem ;
          rdfs:range :Color ;
          owl:equivalentProperty schema:color ;
          rdfs:label "has color"@en ;
          rdfs:comment "Associates a clothing item with one or more colors that appear on it."@en .


###  hasMaterial
:hasMaterial rdf:type owl:ObjectProperty ;
             rdfs:domain :ClothingItem ;
             rdfs:range :Material ;
             owl:equivalentProperty schema:material ;
             rdfs:label "has material"@en ;
             rdfs:comment "Associates a clothing item with its primary fabric or material composition."@en .


###  hasSize
:hasSize rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :ClothingItem ;
         rdfs:range :Size ;
         owl:equivalentProperty schema:size ;
         rdfs:label "has size"@en ;
         rdfs:comment "Associates a clothing item with a single size value drawn from a standard size scale."@en .


###  isAppropriateForOccasion
:isAppropriateForOccasion rdf:type owl:ObjectProperty ;
                          rdfs:domain :ClothingItem ;
                          rdfs:range :Occasion ;
                          rdfs:label "is appropriate for occasion"@en ;
                          rdfs:comment "States that a clothing item or outfit is suitable for a particular social occasion."@en .


###  isAppropriateForSeason
:isAppropriateForSeason rdf:type owl:ObjectProperty ;
                        rdfs:domain :ClothingItem ;
                        rdfs:range :Season ;
                        rdfs:label "is appropriate for season"@en ;
                        rdfs:comment "States that a clothing item or outfit is suitable for a particular season."@en .


###  isSuitableFor
:isSuitableFor rdf:type owl:ObjectProperty ;
               rdfs:domain :ClothingItem ;
               rdfs:range :Gender ;
               rdfs:label "is suitable for gender"@en ;
               rdfs:comment "Indicates that the clothing item is designed or commonly worn for a given gender presentation. Use :Unisex when no preference applies."@en .


###  hasUndertone   (Attribute module — new in v2)
:hasUndertone rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Color ;
              rdfs:range :ColorUndertone ;
              rdfs:label "has undertone"@en ;
              rdfs:comment "The undertone (warm, cool, or neutral) of a color. Used by the color harmony rules of the outfit engine."@en .


###  hasFormality   (Attribute module — new in v2)
:hasFormality rdf:type owl:ObjectProperty ;
              rdfs:domain :ClothingItem ;
              rdfs:range :FormalityLevel ;
              rdfs:label "has formality"@en ;
              rdfs:comment "The dress-code formality level of a clothing item (Casual, SmartCasual, BusinessCasual, FormalDress)."@en .


###  hasColorScheme   (Outfit module — new in v2)
:hasColorScheme rdf:type owl:ObjectProperty ;
                rdfs:domain :Outfit ;
                rdfs:range :ColorScheme ;
                rdfs:label "has color scheme"@en ;
                rdfs:comment "The overall color scheme of an outfit (e.g., Monochromatic, Complementary, Analogous)."@en .


###  hasTop   (Outfit module — new in v2)
:hasTop rdf:type owl:ObjectProperty ;
        rdfs:domain :Outfit ;
        rdfs:range :Top ;
        rdfs:label "has top"@en ;
        rdfs:comment "Relates an Outfit to the Top garment it contains."@en .


###  hasBottom   (Outfit module — new in v2)
:hasBottom rdf:type owl:ObjectProperty ;
           rdfs:domain :Outfit ;
           rdfs:range :Bottom ;
           rdfs:label "has bottom"@en ;
           rdfs:comment "Relates an Outfit to the Bottom garment it contains."@en .


###  hasFootwear   (Outfit module — new in v2)
:hasFootwear rdf:type owl:ObjectProperty ;
             rdfs:domain :Outfit ;
             rdfs:range :Footwear ;
             rdfs:label "has footwear"@en ;
             rdfs:comment "Relates an Outfit to its footwear component."@en .


###  hasOuterwear   (Outfit module — new in v2)
:hasOuterwear rdf:type owl:ObjectProperty ;
              rdfs:domain :Outfit ;
              rdfs:range :Outerwear ;
              rdfs:label "has outerwear"@en ;
              rdfs:comment "Optional outerwear component of an Outfit (jacket, coat, etc.)."@en .


###  hasAccessory   (Outfit module — new in v2)
:hasAccessory rdf:type owl:ObjectProperty ;
              rdfs:domain :Outfit ;
              rdfs:range :Accessory ;
              rdfs:label "has accessory"@en ;
              rdfs:comment "Optional accessory(ies) included in an Outfit (belt, hat, watch, scarf)."@en .


###  pairsWellWith   (Outfit module — new in v2)
:pairsWellWith rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:domain :ClothingItem ;
               rdfs:range :ClothingItem ;
               rdfs:label "pairs well with"@en ;
               rdfs:comment "Symmetric compatibility relation between two clothing items, inferred by the SWRL outfit-compatibility rules."@en .


###  clashesWith   (Outfit module — new in v2)
:clashesWith rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ;
             rdfs:domain :ClothingItem ;
             rdfs:range :ClothingItem ;
             owl:propertyDisjointWith :pairsWellWith ;
             rdfs:label "clashes with"@en ;
             rdfs:comment "Symmetric incompatibility relation between two clothing items (e.g., conflicting formality or clashing colors)."@en .


###  colorHarmonizesWith   (Outfit module — new in v2)
:colorHarmonizesWith rdf:type owl:ObjectProperty ,
                              owl:SymmetricProperty ;
                     rdfs:domain :Color ;
                     rdfs:range :Color ;
                     rdfs:label "color harmonizes with"@en ;
                     rdfs:comment "Symmetric relation between two colors that form an aesthetically pleasing pair according to color-theory heuristics (complementary, analogous, neutral pairing)."@en .


###  isComplementaryTo   (Outfit module — new in v2)
:isComplementaryTo rdf:type owl:ObjectProperty ,
                            owl:SymmetricProperty ;
                   rdfs:subPropertyOf :colorHarmonizesWith ;
                   rdfs:domain :Color ;
                   rdfs:range :Color ;
                   rdfs:label "is complementary to"@en ;
                   rdfs:comment "Specialization of colorHarmonizesWith for the complementary case (opposite hues on the color wheel)."@en .


###  prefersColor   (User module — new in v2)
:prefersColor rdf:type owl:ObjectProperty ;
              rdfs:domain :User ;
              rdfs:range :Color ;
              rdfs:label "prefers color"@en ;
              rdfs:comment "Records a color the user reports as a preference. Used by the personalization layer when ranking recommended outfits."@en .


###  prefersStyle   (User module — new in v2)
:prefersStyle rdf:type owl:ObjectProperty ;
              rdfs:domain :User ;
              rdfs:range :StyleCategory ;
              rdfs:label "prefers style"@en ;
              rdfs:comment "Records a style category the user reports as a preference (Minimalist, Classic, Streetwear, etc.)."@en .


###  hasBodyType   (User module — new in v2)
:hasBodyType rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :User ;
             rdfs:range :BodyType ;
             rdfs:label "has body type"@en ;
             rdfs:comment "Body type of the user, used by future fit-aware recommendations."@en .


###  ownsItem   (User module — new in v2)
:ownsItem rdf:type owl:ObjectProperty ;
          rdfs:domain :User ;
          rdfs:range :ClothingItem ;
          rdfs:label "owns item"@en ;
          rdfs:comment "Associates a user with the clothing items currently in their wardrobe."@en .


###  recommendedOutfit   (User module — new in v2)
:recommendedOutfit rdf:type owl:ObjectProperty ;
                   rdfs:domain :User ;
                   rdfs:range :Outfit ;
                   rdfs:label "recommended outfit"@en ;
                   rdfs:comment "Outfit that the engine has produced as a recommendation for the user."@en .


#################################################################
#    Data Properties
#################################################################

###  brandName
:brandName rdf:type owl:DatatypeProperty ;
           rdfs:domain :ClothingItem ;
           rdfs:range xsd:string ;
           owl:equivalentProperty schema:brand ;
           rdfs:label "brand name"@en ;
           rdfs:comment "Free-text brand or manufacturer name of the clothing item."@en .


###  hasPrice
:hasPrice rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :ClothingItem ;
          rdfs:range xsd:float ;
          owl:equivalentProperty schema:price ;
          rdfs:label "has price"@en ;
          rdfs:comment "Retail price of the clothing item, expressed as a decimal value. Currency is not encoded at the property level."@en .


###  isMachineWashable
:isMachineWashable rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :ClothingItem ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "is machine washable"@en ;
                   rdfs:comment "Boolean flag stating whether the item can be machine-washed."@en .


###  userName   (User module — new in v2)
:userName rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :User ;
          rdfs:range xsd:string ;
          rdfs:label "user name"@en ;
          rdfs:comment "Display name of the user."@en .


###  hasAge   (User module — new in v2)
:hasAge rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :User ;
        rdfs:range xsd:integer ;
        rdfs:label "has age"@en ;
        rdfs:comment "Age of the user in completed years."@en .


#################################################################
#    Classes — Item module
#################################################################

###  ClothingItem
:ClothingItem rdf:type owl:Class ;
              owl:equivalentClass schema:Product ;
              rdfs:label "Clothing Item"@en ;
              rdfs:comment "Top-level class for any wearable article. Direct subclasses partition garments by body region (Top, Bottom, Outerwear, Footwear, Accessory)."@en .


###  Attribute
:Attribute rdf:type owl:Class ;
           rdfs:label "Attribute"@en ;
           rdfs:comment "Abstract grouping class for properties used to describe a ClothingItem (Color, Material, Size, Season, Occasion, Gender, FormalityLevel, ColorScheme, ColorUndertone)."@en .


###  Top
:Top rdf:type owl:Class ;
     rdfs:subClassOf :ClothingItem ;
     rdfs:label "Top"@en ;
     rdfs:comment "Upper-body garment (T-Shirt, Blouse, Sweater, Hoodie, ...)."@en .


###  Bottom
:Bottom rdf:type owl:Class ;
        rdfs:subClassOf :ClothingItem ;
        rdfs:label "Bottom"@en ;
        rdfs:comment "Lower-body garment (Jean, Trouser, Short, Skirt)."@en .


###  Outerwear
:Outerwear rdf:type owl:Class ;
           rdfs:subClassOf :ClothingItem ;
           rdfs:label "Outerwear"@en ;
           rdfs:comment "Outer layer worn over a Top (Jacket, Coat)."@en .


###  Footwear
:Footwear rdf:type owl:Class ;
          rdfs:subClassOf :ClothingItem ;
          rdfs:label "Footwear"@en ;
          rdfs:comment "Foot covering (Boots, Sandals, FormalShoes, SportsShoes)."@en .


###  Accessory
:Accessory rdf:type owl:Class ;
           rdfs:subClassOf :ClothingItem ;
           rdfs:label "Accessory"@en ;
           rdfs:comment "Non-garment wearable that complements an outfit (Belt, Hat, Scarf, Watch)."@en .


###  Top subclasses
:T-Shirt rdf:type owl:Class ; rdfs:subClassOf :Top ;
         rdfs:label "T-Shirt"@en ; rdfs:comment "Short-sleeved knit Top, typically Casual."@en .
:Blouse rdf:type owl:Class ; rdfs:subClassOf :Top ;
        rdfs:label "Blouse"@en ; rdfs:comment "Loose-fitting Top, typically SmartCasual to BusinessCasual."@en .
:Sweater rdf:type owl:Class ; rdfs:subClassOf :Top ;
         rdfs:label "Sweater"@en ; rdfs:comment "Knitted Top suitable for cold seasons."@en .
:Hoodie rdf:type owl:Class ; rdfs:subClassOf :Top ;
        rdfs:label "Hoodie"@en ; rdfs:comment "Hooded sweatshirt; Casual formality."@en .


###  Bottom subclasses
:Jean rdf:type owl:Class ; rdfs:subClassOf :Bottom ;
      rdfs:label "Jean"@en ; rdfs:comment "Denim Bottom; Casual to SmartCasual."@en .
:Trouser rdf:type owl:Class ; rdfs:subClassOf :Bottom ;
         rdfs:label "Trouser"@en ; rdfs:comment "Tailored Bottom; BusinessCasual to FormalDress."@en .
:Short rdf:type owl:Class ; rdfs:subClassOf :Bottom ;
       rdfs:label "Short"@en ; rdfs:comment "Knee-length or shorter Bottom; Casual, Summer-leaning."@en .
:Skirt rdf:type owl:Class ; rdfs:subClassOf :Bottom ;
       rdfs:label "Skirt"@en ; rdfs:comment "Skirted Bottom."@en .


###  Outerwear subclasses
:Jacket rdf:type owl:Class ; rdfs:subClassOf :Outerwear ;
        rdfs:label "Jacket"@en ; rdfs:comment "Hip-length Outerwear."@en .
:Coat rdf:type owl:Class ; rdfs:subClassOf :Outerwear ;
      rdfs:label "Coat"@en ; rdfs:comment "Long Outerwear designed for cold weather."@en .


###  Footwear subclasses
:Boots rdf:type owl:Class ; rdfs:subClassOf :Footwear ;
       rdfs:label "Boots"@en ; rdfs:comment "Ankle-or-higher Footwear, typically Autumn/Winter."@en .
:Sandals rdf:type owl:Class ; rdfs:subClassOf :Footwear ;
         rdfs:label "Sandals"@en ; rdfs:comment "Open Footwear, Summer-leaning."@en .
:FormalShoes rdf:type owl:Class ; rdfs:subClassOf :Footwear ;
             rdfs:label "Formal Shoes"@en ; rdfs:comment "FormalDress-level Footwear (oxford, derby, loafer)."@en .
:SportsShoes rdf:type owl:Class ; rdfs:subClassOf :Footwear ;
             rdfs:label "Sports Shoes"@en ; rdfs:comment "Athletic Footwear (sneaker, running shoe)."@en .


###  Accessory subclasses
:Belt rdf:type owl:Class ; rdfs:subClassOf :Accessory ;
      rdfs:label "Belt"@en ; rdfs:comment "Waist Accessory."@en .
:Hat rdf:type owl:Class ; rdfs:subClassOf :Accessory ;
     rdfs:label "Hat"@en ; rdfs:comment "Head Accessory."@en .
:Scarf rdf:type owl:Class ; rdfs:subClassOf :Accessory ;
       rdfs:label "Scarf"@en ; rdfs:comment "Neck Accessory."@en .
:Watch rdf:type owl:Class ; rdfs:subClassOf :Accessory ;
       rdfs:label "Watch"@en ; rdfs:comment "Wrist Accessory."@en .


#################################################################
#    Classes — Attribute module
#################################################################

:Color rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
       rdfs:label "Color"@en ; rdfs:comment "A named color value (Red, Blue, Black, ...)."@en .

:Material rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
          rdfs:label "Material"@en ; rdfs:comment "A textile material or fabric (Cotton, Wool, Silk, Polyester, ...)."@en .

:Size rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
      rdfs:label "Size"@en ; rdfs:comment "A standard garment size (XS, S, M, L, XL, XXL)."@en .

:Season rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
        rdfs:label "Season"@en ; rdfs:comment "A season of the year (Spring, Summer, Autumn, Winter)."@en .

:Occasion rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
          rdfs:label "Occasion"@en ; rdfs:comment "A social occasion or context (Casual, Work, Formal, Sport)."@en .

:Gender rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
        rdfs:label "Gender"@en ; rdfs:comment "Gender presentation an item is designed for (Male, Female, Unisex)."@en .


###  ColorScheme   (new in v2)
:ColorScheme rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
             rdfs:label "Color Scheme"@en ;
             rdfs:comment "A color-theory scheme applied to an Outfit (Monochromatic, Analogous, Complementary, Triadic, Neutral)."@en .


###  ColorUndertone   (new in v2)
:ColorUndertone rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
                rdfs:label "Color Undertone"@en ;
                rdfs:comment "Undertone classification of a Color: Warm, Cool, or NeutralUndertone."@en .


###  FormalityLevel   (new in v2)
:FormalityLevel rdf:type owl:Class ; rdfs:subClassOf :Attribute ;
                rdfs:label "Formality Level"@en ;
                rdfs:comment "Dress-code level: Casual, SmartCasual, BusinessCasual, FormalDress."@en .


#################################################################
#    Classes — Outfit module   (new in v2)
#################################################################

:Outfit rdf:type owl:Class ;
        rdfs:label "Outfit"@en ;
        rdfs:comment "A complete styled combination of clothing items containing at least a Top, a Bottom and Footwear, optionally extended with Outerwear and Accessories. Outfits are the primary output of the recommendation engine."@en ;
        rdfs:subClassOf
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasTop ;
              owl:someValuesFrom :Top ] ,
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasBottom ;
              owl:someValuesFrom :Bottom ] ,
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasFootwear ;
              owl:someValuesFrom :Footwear ] .


###  HarmoniousOutfit — subclass with defined semantics
:HarmoniousOutfit rdf:type owl:Class ;
                  rdfs:subClassOf :Outfit ;
                  rdfs:label "Harmonious Outfit"@en ;
                  rdfs:comment "An Outfit whose constituent items satisfy the color-harmony and formality-consistency rules. Membership is inferred by the SWRL ruleset."@en .


###  FormalOutfit — Outfit at FormalDress level
:FormalOutfit rdf:type owl:Class ;
              rdfs:subClassOf :Outfit ;
              rdfs:label "Formal Outfit"@en ;
              rdfs:comment "Outfit whose items each have FormalDress formality. Inferred by SWRL rule R2."@en .


###  CasualOutfit
:CasualOutfit rdf:type owl:Class ;
              rdfs:subClassOf :Outfit ;
              rdfs:label "Casual Outfit"@en ;
              rdfs:comment "Outfit whose items each have Casual formality. Inferred by SWRL rule R2'."@en .


#################################################################
#    Classes — User module   (new in v2)
#################################################################

:User rdf:type owl:Class ;
      rdfs:label "User"@en ;
      rdfs:comment "End user of the outfit recommendation engine. Owns clothing items, has stated preferences, and receives recommended Outfits."@en .


:StyleCategory rdf:type owl:Class ;
               rdfs:label "Style Category"@en ;
               rdfs:comment "Named aesthetic style preference (Minimalist, Classic, Streetwear, BohoChic, Sporty, ...)."@en .


:BodyType rdf:type owl:Class ;
          rdfs:label "Body Type"@en ;
          rdfs:comment "Body-shape classification used by future fit-aware recommendations."@en .


#################################################################
#    Individuals — Colors (with undertones)
#################################################################

:Red    rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Warm ;            rdfs:label "Red"@en .
:Orange rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Warm ;            rdfs:label "Orange"@en .
:Yellow rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Warm ;            rdfs:label "Yellow"@en .
:Brown  rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Warm ;            rdfs:label "Brown"@en .
:Blue   rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Cool ;            rdfs:label "Blue"@en .
:Green  rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Cool ;            rdfs:label "Green"@en .
:Purple rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Cool ;            rdfs:label "Purple"@en .
:Pink   rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Cool ;            rdfs:label "Pink"@en .
:Black  rdf:type owl:NamedIndividual , :Color ; :hasUndertone :NeutralUndertone ; rdfs:label "Black"@en .
:White  rdf:type owl:NamedIndividual , :Color ; :hasUndertone :NeutralUndertone ; rdfs:label "White"@en .
:Grey   rdf:type owl:NamedIndividual , :Color ; :hasUndertone :NeutralUndertone ; rdfs:label "Grey"@en .
:Beige  rdf:type owl:NamedIndividual , :Color ; :hasUndertone :NeutralUndertone ; rdfs:label "Beige"@en .
:Navy   rdf:type owl:NamedIndividual , :Color ; :hasUndertone :Cool ;            rdfs:label "Navy"@en .

# Complementary pairs (color wheel opposites)
:Red    :isComplementaryTo :Green .
:Blue   :isComplementaryTo :Orange .
:Yellow :isComplementaryTo :Purple .

# Neutral colors harmonize with everything
:Black :colorHarmonizesWith :Red , :Blue , :Yellow , :Green , :Pink , :Purple , :Orange , :Brown , :White , :Grey , :Beige , :Navy .
:White :colorHarmonizesWith :Red , :Blue , :Yellow , :Green , :Pink , :Purple , :Orange , :Brown , :Black , :Grey , :Beige , :Navy .
:Grey  :colorHarmonizesWith :Red , :Blue , :Yellow , :Green , :Pink , :Purple , :Orange , :Brown , :Black , :White , :Beige , :Navy .


#################################################################
#    Individuals — Color undertones, schemes, formalities
#################################################################

:Warm             rdf:type owl:NamedIndividual , :ColorUndertone ; rdfs:label "Warm"@en .
:Cool             rdf:type owl:NamedIndividual , :ColorUndertone ; rdfs:label "Cool"@en .
:NeutralUndertone rdf:type owl:NamedIndividual , :ColorUndertone ; rdfs:label "Neutral undertone"@en .

:Monochromatic rdf:type owl:NamedIndividual , :ColorScheme ; rdfs:label "Monochromatic"@en .
:Analogous     rdf:type owl:NamedIndividual , :ColorScheme ; rdfs:label "Analogous"@en .
:Complementary rdf:type owl:NamedIndividual , :ColorScheme ; rdfs:label "Complementary"@en .
:Triadic       rdf:type owl:NamedIndividual , :ColorScheme ; rdfs:label "Triadic"@en .
:NeutralScheme rdf:type owl:NamedIndividual , :ColorScheme ; rdfs:label "Neutral scheme"@en .

:CasualLevel         rdf:type owl:NamedIndividual , :FormalityLevel ; rdfs:label "Casual"@en .
:SmartCasualLevel    rdf:type owl:NamedIndividual , :FormalityLevel ; rdfs:label "Smart Casual"@en .
:BusinessCasualLevel rdf:type owl:NamedIndividual , :FormalityLevel ; rdfs:label "Business Casual"@en .
:FormalLevel         rdf:type owl:NamedIndividual , :FormalityLevel ; rdfs:label "Formal Dress"@en .


#################################################################
#    Individuals — Materials, Sizes, Seasons, Occasions, Genders, Styles, BodyTypes
#################################################################

:Cotton    rdf:type owl:NamedIndividual , :Material ; rdfs:label "Cotton"@en .
:Wool      rdf:type owl:NamedIndividual , :Material ; rdfs:label "Wool"@en .
:Silk      rdf:type owl:NamedIndividual , :Material ; rdfs:label "Silk"@en .
